\i ; 讀 Virtuoso OA library，統計 cell、instance、各層圖形數與多邊形最大點數，找出頂層 cell。
\i ; 由 virtuoso.sh 以 virtuoso -nograph -replay 執行；輸出檔名取自環境變數 OA_REPORT。
\# [23:59:39.278626] Periodic Lic check successful
\# [23:59:39.278637] Feature usage summary:
\# [23:59:39.278638] 111
\# [23:59:39.278638] Virtuoso_Adv_Node_Framework
\i let((lib names refd nInst nShape maxPts out cv top)
\i   lib = ddGetObj("B7_CHIP")
\i   names = lib~>cells~>name
\i   refd = makeTable("refd" nil)
\i   nShape = makeTable("nShape" 0)
\i   maxPts = makeTable("maxPts" 0)
\i   nInst = 0
\i   foreach(n names
\i     cv = dbOpenCellViewByType("B7_CHIP" n "layout" nil "r")
\i     when(cv
\i       foreach(i cv~>instances
\i         refd[i~>cellName] = t
\i         nInst = nInst + 1)
\i       foreach(s cv~>shapes
\i         let((k)
\i           k = sprintf(nil "%s/%s/%s" s~>layerName s~>purpose s~>objType)
\i           nShape[k] = nShape[k] + 1
\i           when(s~>objType == "polygon"
\i             maxPts[k] = max(maxPts[k] s~>nPoints))))
\i       dbClose(cv)))
\i   out = outfile(getShellEnvVar("OA_REPORT"))
\i   fprintf(out "cells %d\n" length(names))
\i   fprintf(out "instances %d\n" nInst)
\i   foreach(n names unless(refd[n] fprintf(out "top %s\n" n)))
\i   foreach(k nShape fprintf(out "shapes %s %d %d\n" k nShape[k] maxPts[k]))
\i   top = car(setof(n names !refd[n]))
\i   cv = dbOpenCellViewByType("B7_CHIP" top "layout" nil "r")
\i   fprintf(out "bbox %L\n" cv~>bBox)
\i   fprintf(out "dbu %L\n" cv~>DBUPerUU)
\i   dbClose(cv)
\i   close(out))
\t t
\p > 
\i exit()
